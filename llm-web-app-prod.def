Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Alex Messina
    Version 1.0
    Description LLM Web App container (Production)

%files
    ./ /opt/llm-web-app

%post
    echo "=== Updating base system ==="
    apt-get update && apt-get upgrade -y

    echo "=== Installing prerequisites ==="
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        curl \
        gnupg \
        apt-transport-https \
        build-essential \
        python3-pip \
        python3-venv \
        git \
        sudo \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    echo "=== Installing Node 20 (for frontend build) ==="
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
    npm install -g npm@latest

    echo "=== Setting up Python virtual environment ==="
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --upgrade pip setuptools wheel

    echo "=== Copying application source ==="
    mkdir -p /opt/llm-web-app
    cp -r /tmp/llm-web-app/* /opt/llm-web-app/

    echo "=== Installing backend requirements ==="
    cd /opt/llm-web-app/backend
    /opt/venv/bin/pip install -r requirements.txt
    /opt/venv/bin/pip install gunicorn whitenoise

    echo "=== Building frontend (React) ==="
    cd /opt/llm-web-app/frontend
    npm install
    npm run build

    echo "=== Collecting Django static files ==="
    cd /opt/llm-web-app/backend
    /opt/venv/bin/python manage.py collectstatic --noinput

    echo "=== Cleaning up Node (not needed at runtime) ==="
    apt-get purge -y nodejs npm
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /root/.npm

%environment
    export PATH="/opt/venv/bin:$PATH"
    export DJANGO_SETTINGS_MODULE=backend.settings
    export PYTHONUNBUFFERED=1
    export NODE_ENV=production

%runscript
    echo "=== Starting LLM Web App (Production) ==="
    cd /opt/llm-web-app/backend
    exec gunicorn backend.wsgi:application \
        --bind 0.0.0.0:8000 \
        --workers 4 \
        --timeout 120
