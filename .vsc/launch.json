{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Django in Dev Container",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/backend/manage.py",
      "args": ["runserver", "0.0.0.0:8000"],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal",
      "env": {
        "APPTAINER_CONF": "/etc/apptainer/apptainer.conf"
      }
    }
  ]
}
