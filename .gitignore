# ── Logs ──────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules
dist
dist-ssr
*.local
package-lock.json

# ── Python ────────────────────────────────────────────────────────────────────
venv
__pycache__
*.pyc
*.pyo

# ── Environment — NEVER commit secrets ────────────────────────────────────────
.env
# .env.template is intentionally NOT listed here — it should be committed
# so forks know what values they need to fill in.

# ── Editor ────────────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Deployment artifacts (generated by deploy.sh — not source code) ───────────
*.sif
releases/
shared/
tmp/