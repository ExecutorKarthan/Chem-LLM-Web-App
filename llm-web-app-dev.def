Bootstrap: docker
From: rockylinux:8

%labels
    Author Xander
    Description LLM-Web-App Development Container (Django + React)

%environment
    export LANG=C.UTF-8
    export PATH=/usr/local/bin:$PATH
    export PYTHONUNBUFFERED=1
    export NODE_ENV=development
    export DJANGO_PORT=8000
    export REACT_PORT=3000
    export APP_HOME=/opt/app/LLM-Web-App

%post
    set -e
    echo "=== Installing system packages ==="
    dnf clean all
    dnf -y update
    dnf -y install epel-release
    dnf -y install vim git wget curl tar gzip bzip2 make gcc gcc-c++ which sudo \
        openssl-devel bzip2-devel xz-devel zlib-devel libffi-devel readline-devel \
        sqlite-devel findutils
    dnf clean all

    ############################################################
    # 1. Clone repository
    ############################################################
    echo "=== Cloning LLM-Web-App repo ==="
    mkdir -p /opt/app
    cd /opt/app
    if [ ! -d "LLM-Web-App" ]; then
        git clone --branch apptainer-deploy --single-branch https://github.com/ExecutorKarthan/LLM-Web-App.git
    fi
    chmod -R 777 "LLM-Web-App"

    ############################################################
    # 2. Install Python 3.12
    ############################################################
    PYTHON_VERSION=3.12.0
    PYTHON_INSTALL_DIR=/opt/python-$PYTHON_VERSION
    mkdir -p /opt/app/tmp_build
    cd /opt/app/tmp_build
    wget -q https://www.python.org/ftp/python/$PYTHON_VERSION/Python-$PYTHON_VERSION.tgz
    tar xzf Python-$PYTHON_VERSION.tgz
    cd Python-$PYTHON_VERSION
    ./configure --prefix=$PYTHON_INSTALL_DIR --enable-optimizations
    make -j$(nproc)
    make altinstall

    PY_SHORT=$(echo $PYTHON_VERSION | cut -d. -f1,2)
    alternatives --install /usr/bin/python3 python3 $PYTHON_INSTALL_DIR/bin/python$PY_SHORT 2
    alternatives --install /usr/bin/pip3 pip3 $PYTHON_INSTALL_DIR/bin/pip$PY_SHORT 2
    $PYTHON_INSTALL_DIR/bin/python$PY_SHORT -m ensurepip --upgrade
    $PYTHON_INSTALL_DIR/bin/python$PY_SHORT -m pip install --upgrade pip setuptools wheel

    ############################################################
    # 3. Install Node.js 20 + Yarn
    ############################################################
    if ! command -v node &>/dev/null; then
        curl -fsSL https://rpm.nodesource.com/setup_20.x | bash -
        dnf -y install nodejs
    fi
    npm install -g npm@latest
    npm install -g yarn@latest

    ############################################################
    # 4. Upgrade SQLite >=3.41
    ############################################################
    cd /opt/app/tmp_build
    wget -q https://www.sqlite.org/2023/sqlite-autoconf-3410200.tar.gz
    tar -xzf sqlite-autoconf-3410200.tar.gz
    cd sqlite-autoconf-3410200
    ./configure --prefix=/usr/local
    make -j$(nproc)
    make install
    ldconfig
    alternatives --remove sqlite3 /usr/bin/sqlite3 || true
    alternatives --install /usr/bin/sqlite3 sqlite3 /usr/local/bin/sqlite3 50
    echo "/usr/local/lib" > /etc/ld.so.conf.d/sqlite3.conf
    ldconfig

    ############################################################
    # 5. Backend setup
    ############################################################
    BACKEND_DIR=/opt/app/LLM-Web-App/backend
    cd $BACKEND_DIR
    rm -rf venv
    $PYTHON_INSTALL_DIR/bin/python$PY_SHORT -m venv venv
    source venv/bin/activate
    pip install --upgrade pip setuptools wheel
    pip install django python-dotenv django-cors-headers
    if [ -f requirements.txt ]; then
        sed -i 's/annotated-types==0.7.0/annotated-types>=0.9.0/' requirements.txt || true
        pip install -r requirements.txt
    fi

    if [ ! -f .env ]; then
        DJANGO_KEY=$(python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())')
        echo "DJANGO_SECRET_KEY=$DJANGO_KEY" > .env
        echo "✅ Created .env with DJANGO_SECRET_KEY"
    fi

    mkdir -p "$BACKEND_DIR/staticfiles_collected"
    chmod -R 777 "$BACKEND_DIR/staticfiles_collected"
    python manage.py collectstatic --noinput || true
    deactivate

    ############################################################
    # 6. Frontend setup
    ############################################################
    FRONTEND_DIR=/opt/app/LLM-Web-App/frontend
    cd $FRONTEND_DIR
    if [ -f package.json ]; then
        yarn install --frozen-lockfile
        yarn build
    fi

%runscript
    echo "=== Starting LLM-Web-App container ==="

    # Exit everything on Ctrl+C
    trap "echo '=== Stopping servers...'; kill 0" EXIT

    # ------------------------------
    # Start Django backend in background
    # ------------------------------
    BACKEND_DIR=/opt/app/LLM-Web-App/backend
    ENV_FILE="$BACKEND_DIR/.env"
    if [ ! -f "$ENV_FILE" ]; then
        echo "❌ .env file not found in backend!"
        exit 1
    fi
    DJANGO_KEY=$(grep DJANGO_SECRET_KEY "$ENV_FILE" | cut -d '=' -f2)
    if [ -z "$DJANGO_KEY" ]; then
        echo "❌ DJANGO_SECRET_KEY not found in .env or empty!"
        exit 1
    fi

    echo "✅ Found .env and DJANGO_SECRET_KEY is set"

    if [ -f "$BACKEND_DIR/manage.py" ]; then
        echo "=== Starting Django backend on port $DJANGO_PORT ==="
        cd "$BACKEND_DIR"
        source venv/bin/activate
        python manage.py migrate --noinput || true
        python manage.py collectstatic --noinput || true
        # Run Django in background with logs to stdout
        python manage.py runserver 0.0.0.0:$DJANGO_PORT &
    fi

    # ------------------------------
    # Start React frontend
    # ------------------------------
    FRONTEND_DIR=/opt/app/LLM-Web-App/frontend
    FRONTEND_BUILD_DIR="$FRONTEND_DIR/build"
    cd "$FRONTEND_DIR"

    if [ -d "$FRONTEND_BUILD_DIR" ]; then
        echo "=== Serving React production build on port $REACT_PORT ==="
        cd "$FRONTEND_BUILD_DIR"
        python3 -m http.server $REACT_PORT
    else
        echo "=== Build not found, starting React dev server ==="
        cd "$FRONTEND_DIR"
        yarn dev --host 0.0.0.0 --port $REACT_PORT
    fi

    # Wait for all background processes (Django) to finish
wait
