Bootstrap: docker
From: ubuntu:22.04

%labels
    Author Alex Messina
    Version 1.0
    Description LLM Web App container (Development)

%post
    echo "=== Updating base system ==="
    apt-get update && apt-get upgrade -y

    echo "=== Installing prerequisites ==="
    DEBIAN_FRONTEND=noninteractive apt-get install -y \
        curl \
        gnupg \
        apt-transport-https \
        build-essential \
        python3-pip \
        python3-venv \
        git \
        sudo \
        && apt-get clean && rm -rf /var/lib/apt/lists/*

    echo "=== Installing Node 20 ==="
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
    npm install -g npm@latest
    npm install -g concurrently

    echo "=== Setting up Python virtual environment ==="
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --upgrade pip setuptools wheel

    echo "=== Copying application source (dev) ==="
    mkdir -p /opt/llm-web-app
    cp -r /tmp/llm-web-app/* /opt/llm-web-app/

    echo "=== Installing backend requirements ==="
    cd /opt/llm-web-app/backend
    /opt/venv/bin/pip install -r requirements.txt

    echo "=== Installing frontend dependencies ==="
    cd /opt/llm-web-app/frontend
    npm install

%environment
    export PATH="/opt/venv/bin:$PATH"
    export NODE_PATH="/usr/lib/node_modules"
    export DJANGO_SETTINGS_MODULE=backend.settings
    export PYTHONUNBUFFERED=1
    export NODE_ENV=development

%runscript
    echo "=== Running LLM Web App (Development) ==="
    cd /opt/llm-web-app
    concurrently \
        "/opt/venv/bin/python backend/manage.py runserver 0.0.0.0:8000" \
        "cd frontend && npm run dev -- --host 0.0.0.0 --port 3000"
