Bootstrap: docker
From: python:3.13-slim

%labels
    Author Chem-LLM-Web-App
    Version 1.0
    Description Django + React chemistry LLM web application

%environment
    # Python
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PATH="/opt/venv/bin:$PATH"

    # Node - installed at build time under /opt/node
    export PATH="/opt/node/bin:$PATH"

    # Django will look for .env here (bind-mounted source)
    export DJANGO_SETTINGS_MODULE=backend_project.settings

%post
    # ─────────────────────────────────────────────────────────────────────────
    # 0. Timestamp and base system packages
    # ─────────────────────────────────────────────────────────────────────────
    BUILD_DATE=$(date '+%Y-%m-%d %H:%M:%S')
    echo "=== BUILD STARTED: $BUILD_DATE ===" > /build_log.txt

    apt-get update -y && apt-get install -y \
        curl \
        git \
        ca-certificates \
        build-essential \
        && apt-get clean \
        && rm -rf /var/lib/apt/lists/*

    echo "=== System packages installed ===" >> /build_log.txt

    # ─────────────────────────────────────────────────────────────────────────
    # 1. Install latest Node.js (via NodeSource - tracks latest LTS)
    # ─────────────────────────────────────────────────────────────────────────
    NODE_MAJOR=24
    curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
    apt-get install -y nodejs
    node --version >> /build_log.txt
    npm --version >> /build_log.txt
    echo "=== Node.js installed ===" >> /build_log.txt

    # ─────────────────────────────────────────────────────────────────────────
    # 2. Python virtual environment
    # ─────────────────────────────────────────────────────────────────────────
    python3 --version >> /build_log.txt
    python3 -m venv /opt/venv
    /opt/venv/bin/pip install --upgrade pip setuptools wheel
    pip --version >> /build_log.txt
    echo "=== Python venv created ===" >> /build_log.txt

    # ─────────────────────────────────────────────────────────────────────────
    # 3. Create app directory structure
    #    Source files are bind-mounted at runtime from the host.
    #    We create the directories here so the mount points exist.
    # ─────────────────────────────────────────────────────────────────────────
    mkdir -p /app/source
    mkdir -p /app/logs
    mkdir -p /app/data

    echo "=== Directory structure created ===" >> /build_log.txt
    echo "=== BUILD COMPLETE ===" >> /build_log.txt

%runscript
    # ─────────────────────────────────────────────────────────────────────────
    # This runs every time the container starts (via pm2 or manually).
    # Source files are already bind-mounted at /app/source by deploy.sh.
    # ─────────────────────────────────────────────────────────────────────────
    exec /app/source/container_start.sh

%test
    # Basic sanity checks run after build
    echo "--- Apptainer build test ---"
    python3 --version
    node --version
    npm --version
    /opt/venv/bin/python --version
    /opt/venv/bin/pip --version
    echo "--- All checks passed ---"
