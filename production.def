Bootstrap: docker
From: rockylinux:9

%labels
    Author LLM Web App Team
    Version 1.0
    Description Production container for LLM Web App on llmexplorer.engr.wustl.edu

%help
    Production container for the LLM Web Application.
    Runs on llmexplorer.engr.wustl.edu:8000
    
    Usage:
        # Simply run the container
        apptainer run production.sif
    
    The app will be available at:
        http://llmexplorer.engr.wustl.edu:8000
    
    Logs are written to /tmp/llm-app-logs/ inside the container.
    Note: Django secret key is auto-generated during build.

%environment
    # Python environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PATH="/opt/python/bin:$PATH"
    
    # Django settings
    export DJANGO_SETTINGS_MODULE=backend_project.settings
    export DJANGO_STATIC_ROOT=/opt/app/staticfiles
    export DJANGO_DEBUG=False
    
    # Application paths
    export APP_ROOT=/opt/app
    export BACKEND_ROOT=/opt/app/backend
    export FRONTEND_ROOT=/opt/app/frontend
    
    # Server configuration
    export SERVER_HOST=llmexplorer.engr.wustl.edu
    export SERVER_PORT=8000
    export WORKERS=4

%post
    echo "========================================="
    echo "Building Production Container"
    echo "========================================="
    
    # Update system and install build dependencies
    echo "Installing system dependencies..."
    dnf update -y

    # Enable CRB repository (required for gdbm-devel, libpcap-devel, etc.)
    dnf install -y dnf-plugins-core
    dnf config-manager --set-enabled crb

    # Now install the dependencies
    dnf install -y --allowerasing gcc gcc-c++ make git wget bzip2 tar gzip \
        libffi-devel openssl-devel sqlite-devel zlib-devel \
        bzip2-devel readline-devel xz-devel ncurses-devel \
        gdbm-devel libpcap-devel expat-devel libdb-devel \
        || { echo "ERROR: Failed to install system dependencies"; exit 1; }
    
    # Install Python 3.11
    echo "Installing Python 3.11..."
    cd /tmp
    if [ ! -f "Python-3.11.8.tgz" ]; then
        wget https://www.python.org/ftp/python/3.11.8/Python-3.11.8.tgz \
            || { echo "ERROR: Failed to download Python"; exit 1; }
    fi
    tar -xzf Python-3.11.8.tgz
    cd Python-3.11.8
    ./configure --prefix=/opt/python --enable-optimizations \
        || { echo "ERROR: Python configure failed"; exit 1; }
    make -j$(nproc) \
        || { echo "ERROR: Python build failed"; exit 1; }
    make install \
        || { echo "ERROR: Python install failed"; exit 1; }
    
    # Verify Python installation
    if [ ! -f "/opt/python/bin/python3.11" ]; then
        echo "ERROR: Python installation failed"
        exit 1
    fi
    
    # Create symlinks
    ln -sf /opt/python/bin/python3.11 /usr/local/bin/python3
    ln -sf /opt/python/bin/pip3.11 /usr/local/bin/pip3
    
    # Upgrade pip
    echo "Upgrading pip..."
    /opt/python/bin/pip3 install --upgrade pip setuptools wheel \
        || { echo "ERROR: Failed to upgrade pip"; exit 1; }
    
    # Install Node.js 20.x
    echo "Installing Node.js 20.x..."
    curl -fsSL https://rpm.nodesource.com/setup_20.x | bash - \
        || { echo "ERROR: Failed to setup Node.js repository"; exit 1; }
    dnf install -y nodejs \
        || { echo "ERROR: Failed to install Node.js"; exit 1; }
    
    # Verify Node installation
    node --version || { echo "ERROR: Node installation failed"; exit 1; }
    npm --version || { echo "ERROR: npm installation failed"; exit 1; }
    
    # Clone repository
    echo "Cloning repository..."
    cd /opt
    if [ -d "app" ]; then
        echo "Removing existing app directory..."
        rm -rf app
    fi
    
    # Clone from GitHub (update this URL to your actual repository)
    git clone https://github.com/ExecutorKarthan/LLM-Web-App.git app \
        || { echo "ERROR: Failed to clone repository. Update GitHub URL in production.def"; exit 1; }
    
    cd /opt/app
    
    # Verify repository structure
    if [ ! -d "backend" ] || [ ! -d "frontend" ]; then
        echo "ERROR: Invalid repository structure. Missing backend or frontend directories."
        exit 1
    fi
    
    # Install Python dependencies
    echo "Installing Python dependencies..."
    cd /opt/app/backend
    if [ ! -f "requirements.txt" ]; then
        echo "ERROR: requirements.txt not found"
        exit 1
    fi
    /opt/python/bin/pip3 install -r requirements.txt \
        || { echo "ERROR: Failed to install Python dependencies"; exit 1; }
    
    # Install frontend dependencies
    echo "Installing frontend dependencies..."
    cd /opt/app/frontend
    if [ ! -f "package.json" ]; then
        echo "ERROR: package.json not found"
        exit 1
    fi
    npm install \
        || { echo "ERROR: Failed to install frontend dependencies"; exit 1; }
    
    # Build frontend
    echo "Building frontend..."
    
    # Set environment variable for Vite build (production URL)
    export VITE_BACKEND_URL="http://llmexplorer.engr.wustl.edu:8000"
    
    npm run build \
        || { echo "ERROR: Frontend build failed"; exit 1; }
    
    # Verify frontend build
    if [ ! -f "dist/index.html" ]; then
        echo "ERROR: Frontend build did not produce dist/index.html"
        exit 1
    fi
    
    # Create necessary directories
    echo "Creating application directories..."
    mkdir -p /opt/app/staticfiles
    mkdir -p /opt/app/backend/db
    mkdir -p /opt/app/logs
    chmod 777 /opt/app/logs
    
    # Generate Django secret key and save it securely
    echo "Generating Django secret key..."
    /opt/python/bin/python3 -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())' > /opt/app/.secret_key
    chmod 600 /opt/app/.secret_key
    
    # Create missing views.py for frontend serving
    echo "Creating backend_project/views.py..."
    cat > /opt/app/backend/backend_project/views.py << 'VIEWSPY'
from django.shortcuts import render
from django.http import HttpResponse
from pathlib import Path

def frontend(request):
    """Serve the React frontend index.html"""
    try:
        return render(request, "index.html")
    except Exception as e:
        return HttpResponse(f"Error loading frontend: {e}", status=500)
VIEWSPY

    # Patch urls.py to add frontend routes
    echo "Patching urls.py to add frontend routes..."
    cat > /tmp/patch_urls.py << 'EOF'
# Read the urls.py file
with open('/opt/app/backend/backend_project/urls.py', 'r') as f:
    content = f.read()

# Check if frontend routes already exist
if 'from backend_project.views import frontend' not in content:
    # Replace the entire urlpatterns
    new_content = '''# Import needed modules
from django.contrib import admin
from django.urls import path, include, re_path
from backend_project.views import frontend

# Define URL patterns for app navigation
urlpatterns = [
    path('admin/', admin.site.urls),
    path('api/', include('api.urls')),
    
    # Root route -> React
    path("", frontend, name="frontend_root"),
    
    # SPA fallback: anything not /api or /admin
    re_path(r"^(?!api/|admin/).*$", frontend, name="frontend_catchall"),
]
'''
    
    with open('/opt/app/backend/backend_project/urls.py', 'w') as f:
        f.write(new_content)
    
    print("urls.py patched successfully")
else:
    print("urls.py already has frontend routes")
EOF
    
    /opt/python/bin/python3 /tmp/patch_urls.py
    
    # Patch api/views.py to add @csrf_exempt to all views
    echo "Patching api/views.py to add CSRF exemptions..."
    cat > /tmp/patch_api_views.py << 'EOF'
# Read the views file
with open('/opt/app/backend/api/views.py', 'r') as f:
    lines = f.readlines()

# Process line by line
new_lines = []
i = 0
while i < len(lines):
    line = lines[i]
    
    # If we find @api_view, check if @csrf_exempt is already above it
    if '@api_view' in line:
        # Look back to see if csrf_exempt is already there
        has_csrf_exempt = False
        for j in range(max(0, i-5), i):
            if '@csrf_exempt' in lines[j]:
                has_csrf_exempt = True
                break
        
        # If not, add it
        if not has_csrf_exempt:
            new_lines.append('@csrf_exempt\n')
    
    new_lines.append(line)
    i += 1

# Write back
with open('/opt/app/backend/api/views.py', 'w') as f:
    f.writelines(new_lines)

print("api/views.py patched - added @csrf_exempt to all API views")
EOF
    
    /opt/python/bin/python3 /tmp/patch_api_views.py
    
    # Fix TEMPLATES configuration in settings.py to enable template loading
    echo "Patching settings.py to fix template loading..."
    cd /opt/app/backend/backend_project
    
    # Create a patch script
    cat > /tmp/patch_settings.py << 'EOF'
import re

# Read the settings file
with open('/opt/app/backend/backend_project/settings.py', 'r') as f:
    content = f.read()

# Add REACT_BUILD_DIR after BASE_DIR
if 'REACT_BUILD_DIR' not in content:
    # Find the line with BASE_DIR and add REACT_BUILD_DIR after it
    lines = content.split('\n')
    new_lines = []
    for i, line in enumerate(lines):
        new_lines.append(line)
        if 'BASE_DIR = Path(__file__).resolve().parent.parent' in line:
            new_lines.append('')
            new_lines.append('# React frontend build directory')
            new_lines.append('REACT_BUILD_DIR = BASE_DIR.parent / "frontend" / "dist"')
    content = '\n'.join(new_lines)

# Change APP_DIRS to True
content = content.replace("'APP_DIRS': False,", "'APP_DIRS': True,")

# Replace empty DIRS with REACT_BUILD_DIR in TEMPLATES
content = content.replace("'DIRS': [],", "'DIRS': [REACT_BUILD_DIR],")

# Fix STATIC_URL to match React build output
content = content.replace("STATIC_URL = '/static/'", "STATIC_URL = '/assets/'")

# Fix STATICFILES_DIRS to include React build assets
old_staticfiles = "STATICFILES_DIRS = [\n    BASE_DIR / 'assets' / 'static',\n]"
new_staticfiles = """STATICFILES_DIRS = [
    BASE_DIR / 'assets' / 'static',
    BASE_DIR.parent / 'frontend' / 'dist' / 'assets',
]"""
content = content.replace(old_staticfiles, new_staticfiles)

# Fix CORS_ALLOWED_ORIGINS for production
old_cors = '''CORS_ALLOWED_ORIGINS = [
    "https://llm-web-app-4970.onrender.com",
    "http://localhost:5173"
]'''
new_cors = '''CORS_ALLOWED_ORIGINS = [
    "http://llmexplorer.engr.wustl.edu:8000",
    "https://llm-web-app-4970.onrender.com",
    "http://localhost:5173"
]'''
content = content.replace(old_cors, new_cors)

# Fix CSRF_TRUSTED_ORIGINS for production
content = content.replace(
    'CSRF_TRUSTED_ORIGINS = [\n    "http://llmexplorer.engr.wustl.edu:8000",\n    "https://llm-web-app-4970.onrender.com/",  \n]',
    '''CSRF_TRUSTED_ORIGINS = [
    "http://llmexplorer.engr.wustl.edu:8000",
    "https://llm-web-app-4970.onrender.com",  
]'''
)

# Write back
with open('/opt/app/backend/backend_project/settings.py', 'w') as f:
    f.write(content)

print("Settings.py patched successfully")
EOF
    
    # Execute the patch script
    /opt/python/bin/python3 /tmp/patch_settings.py
    
    # Verify the patch
    echo "Verifying patch..."
    grep -q "REACT_BUILD_DIR" /opt/app/backend/backend_project/settings.py && echo "✓ REACT_BUILD_DIR added" || echo "✗ REACT_BUILD_DIR not found"
    grep -q "'DIRS': \[REACT_BUILD_DIR\]" /opt/app/backend_project/settings.py && echo "✓ DIRS updated" || echo "✗ DIRS not updated"
    grep -q "STATIC_URL = '/assets/'" /opt/app/backend/backend_project/settings.py && echo "✓ STATIC_URL updated to /assets/" || echo "✗ STATIC_URL not updated"
    grep -q '"http://llmexplorer.engr.wustl.edu:8000"' /opt/app/backend/backend_project/settings.py && echo "✓ CORS_ALLOWED_ORIGINS updated" || echo "✗ CORS not updated"
    
    # Collect static files
    echo "Collecting static files..."
    cd /opt/app/backend
    DJANGO_SECRET_KEY=$(cat /opt/app/.secret_key) /opt/python/bin/python3 manage.py collectstatic --noinput \
        || { echo "WARNING: collectstatic failed, but continuing..."; }
    
    # Create/migrate database
    echo "Setting up database..."
    DJANGO_SECRET_KEY=$(cat /opt/app/.secret_key) /opt/python/bin/python3 manage.py migrate --noinput \
        || { echo "WARNING: migrate failed, but continuing..."; }
    
    # Clean up build artifacts
    echo "Cleaning up..."
    dnf clean all
    
    # Create startup script
    cat > /opt/app/start.sh << 'STARTSCRIPT'
#!/bin/bash

# Load the auto-generated secret key
export DJANGO_SECRET_KEY=$(cat /opt/app/.secret_key)

# Startup script for production container
cd /opt/app/backend

# Create logs directory in /tmp (writable in container)
# /tmp is always writable in Apptainer containers
mkdir -p /tmp/llm-app-logs || {
    echo "ERROR: Failed to create logs directory"
    echo "Falling back to stdout/stderr logging"
    LOG_ACCESS="-"
    LOG_ERROR="-"
}

# Set log paths (fallback to stdout/stderr if mkdir failed)
LOG_ACCESS=${LOG_ACCESS:-/tmp/llm-app-logs/access.log}
LOG_ERROR=${LOG_ERROR:-/tmp/llm-app-logs/error.log}

echo "========================================="
echo "LLM Web App - Production"
echo "========================================="
echo "Server: http://${SERVER_HOST}:${SERVER_PORT}"
echo "Workers: ${WORKERS}"
echo "Logs: ${LOG_ACCESS}"
echo "========================================="

# Start gunicorn
exec /opt/python/bin/gunicorn \
    --bind ${SERVER_HOST}:${SERVER_PORT} \
    --workers ${WORKERS} \
    --timeout 120 \
    --access-logfile ${LOG_ACCESS} \
    --error-logfile ${LOG_ERROR} \
    --log-level info \
    --chdir /opt/app/backend \
    backend_project.wsgi:application
STARTSCRIPT
    
    chmod +x /opt/app/start.sh
    
    echo "========================================="
    echo "Build Complete!"
    echo "========================================="

%runscript
    exec /opt/app/start.sh

%test
    echo "Running container tests..."
    
    # Test Python installation
    echo "Testing Python..."
    /opt/python/bin/python3 --version || exit 1
    
    # Test Node installation
    echo "Testing Node.js..."
    node --version || exit 1
    npm --version || exit 1
    
    # Test repository structure
    echo "Testing repository structure..."
    [ -d "/opt/app/backend" ] || { echo "ERROR: /opt/app/backend missing"; exit 1; }
    [ -d "/opt/app/frontend" ] || { echo "ERROR: /opt/app/frontend missing"; exit 1; }
    [ -f "/opt/app/backend/manage.py" ] || { echo "ERROR: manage.py missing"; exit 1; }
    
    # Test secret key file exists
    echo "Testing secret key..."
    [ -f "/opt/app/.secret_key" ] || { echo "ERROR: .secret_key missing"; exit 1; }
    
    # Test Django
    echo "Testing Django..."
    cd /opt/app/backend
    DJANGO_SECRET_KEY=$(cat /opt/app/.secret_key) /opt/python/bin/python3 manage.py check || exit 1
    
    # Verify static files exist
    echo "Testing static files..."
    [ -d "/opt/app/staticfiles" ] || { echo "ERROR: staticfiles directory missing"; exit 1; }
    
    # Verify frontend build exists
    echo "Testing frontend build..."
    [ -f "/opt/app/frontend/dist/index.html" ] || { echo "ERROR: frontend build missing"; exit 1; }
    
    # Test startup script exists
    [ -f "/opt/app/start.sh" ] || { echo "ERROR: start.sh missing"; exit 1; }
    [ -x "/opt/app/start.sh" ] || { echo "ERROR: start.sh not executable"; exit 1; }
    
    echo "========================================="
    echo "All tests passed!"
    echo "========================================="