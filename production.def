Bootstrap: docker
From: rockylinux:9

%labels
    Author LLM Web App Team
    Version 1.0-production
    Description Production container for LLM Web App
    Maintainer your-email@domain.com

%help
    Production container for the LLM Web Application.
    
    Usage:
        apptainer run production.sif
    
    The app will be available at:
        http://your-domain:8000
    
    Environment Variables (set before running):
        DJANGO_SECRET_KEY     - Django secret key (REQUIRED)
        ALLOWED_HOSTS         - Comma-separated list of allowed hosts
        REDIS_URL             - Redis connection URL (default: redis://127.0.0.1:6379/1)
        SERVER_PORT           - Server port (default: 8000)
        WORKERS               - Number of Gunicorn workers (default: 4)
    
    Example:
        export DJANGO_SECRET_KEY="your-secret-key-here"
        export ALLOWED_HOSTS="yourdomain.com,www.yourdomain.com"
        apptainer run production.sif

%environment
    # Python environment
    export PYTHONUNBUFFERED=1
    export PYTHONDONTWRITEBYTECODE=1
    export PATH="/opt/python/bin:$PATH"
    
    # Django settings
    export DJANGO_SETTINGS_MODULE=backend_project.settings
    export DJANGO_STATIC_ROOT=/opt/app/staticfiles
    export DJANGO_DEBUG=False
    
    # Application paths
    export APP_ROOT=/opt/app
    export BACKEND_ROOT=/opt/app/backend
    export FRONTEND_ROOT=/opt/app/frontend
    
    # Server configuration - PRODUCTION DEFAULTS
    export SERVER_HOST=0.0.0.0
    export SERVER_PORT=${SERVER_PORT:-8000}
    export WORKERS=${WORKERS:-4}

    # Redis Configuration
    export REDIS_HOST=127.0.0.1
    export REDIS_PORT=6379
    export REDIS_URL=${REDIS_URL:-redis://127.0.0.1:6379/1}

%post
    echo "========================================="
    echo "Building Production Container"
    echo "========================================="
    
    # Update system and install dependencies
    echo "Installing system dependencies..."
    dnf -y install dnf-plugins-core
    dnf config-manager --set-enabled crb
    dnf install -y --allowerasing \
        gcc gcc-c++ make git wget bzip2 tar gzip \
        libffi-devel openssl-devel sqlite-devel zlib-devel \
        bzip2-devel readline-devel xz-devel ncurses-devel \
        gdbm-devel libpcap-devel expat-devel libdb-devel \
        || { echo "ERROR: Failed to install system dependencies"; exit 1; }

    # Install Redis
    echo "Installing Redis..."
    dnf install -y redis || { echo "ERROR: Failed to install Redis"; exit 1; }

    # Test Redis installation (build-time only)
    echo "Testing Redis installation..."
    cat > /tmp/redis-test.conf << 'REDISCONF'
bind 127.0.0.1
port 6379
daemonize yes
pidfile /tmp/redis-test.pid
logfile /tmp/redis-test.log
dir /tmp
dbfilename dump-test.rdb
REDISCONF
    
    redis-server /tmp/redis-test.conf
    sleep 2
    
    if redis-cli ping > /dev/null 2>&1; then
        echo "✓ Redis test successful"
        redis-cli shutdown NOSAVE 2>/dev/null || true
        sleep 1
        pkill -9 redis-server 2>/dev/null || true
    else
        echo "ERROR: Redis test failed"
        exit 1
    fi
    
    rm -f /tmp/redis-test.* /tmp/dump-test.rdb
    
    # Install Python 3.11
    echo "Installing Python 3.11..."
    cd /tmp
    wget https://www.python.org/ftp/python/3.11.8/Python-3.11.8.tgz \
        || { echo "ERROR: Failed to download Python"; exit 1; }
    tar -xzf Python-3.11.8.tgz
    cd Python-3.11.8
    ./configure --prefix=/opt/python --enable-optimizations \
        || { echo "ERROR: Python configure failed"; exit 1; }
    make -j$(nproc) \
        || { echo "ERROR: Python build failed"; exit 1; }
    make install \
        || { echo "ERROR: Python install failed"; exit 1; }
    
    ln -sf /opt/python/bin/python3.11 /usr/local/bin/python3
    ln -sf /opt/python/bin/pip3.11 /usr/local/bin/pip3
    
    # Upgrade pip
    echo "Upgrading pip..."
    /opt/python/bin/pip3 install --upgrade pip setuptools wheel \
        || { echo "ERROR: Failed to upgrade pip"; exit 1; }
    
    # Install Node.js 20.x
    echo "Installing Node.js 20.x..."
    curl -fsSL https://rpm.nodesource.com/setup_20.x | bash - \
        || { echo "ERROR: Failed to setup Node.js repository"; exit 1; }
    dnf install -y nodejs \
        || { echo "ERROR: Failed to install Node.js"; exit 1; }
    
    # Clone repository - PRODUCTION BRANCH
    echo "Cloning repository (apptainer-deploy branch)..."
    cd /opt
    rm -rf app 2>/dev/null || true
    
    # Clone from your repository
    git clone -b apptainer-deploy --single-branch https://github.com/ExecutorKarthan/LLM-Web-App.git app \
        || { echo "ERROR: Failed to clone repository"; exit 1; }
    
    cd /opt/app
    
    # Verify branch
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
    if [ "$CURRENT_BRANCH" != "apptainer-deploy" ]; then
        echo "ERROR: Not on apptainer-deploy branch (current: $CURRENT_BRANCH)"
        exit 1
    fi
    
    # Record build metadata
    git rev-parse HEAD > /opt/app/.git-commit
    git describe --always --tags > /opt/app/.git-version 2>/dev/null || echo "no-tag" > /opt/app/.git-version
    date -u > /opt/app/.build-date
    
    echo "✓ Built from commit: $(cat /opt/app/.git-commit)"
    echo "✓ Version: $(cat /opt/app/.git-version)"

    # Verify repository structure
    if [ ! -d "backend" ] || [ ! -d "frontend" ]; then
        echo "ERROR: Invalid repository structure"
        exit 1
    fi
    
    # Install Python dependencies
    echo "Installing Python dependencies..."
    cd /opt/app/backend
    /opt/python/bin/pip3 install -r requirements.txt \
        || { echo "ERROR: Failed to install Python dependencies"; exit 1; }
    
    # Install frontend dependencies
    echo "Installing frontend dependencies..."
    cd /opt/app/frontend
    npm ci --production \
        || { echo "ERROR: Failed to install frontend dependencies"; exit 1; }
    
    # Build frontend for production
    echo "Building frontend for production..."
    export NODE_ENV=production
    export VITE_BACKEND_URL=""
    npm run build \
        || { echo "ERROR: Frontend build failed"; exit 1; }
    
    if [ ! -f "dist/index.html" ]; then
        echo "ERROR: Frontend build did not produce dist/index.html"
        exit 1
    fi
    
    # Clean up node_modules to save space
    echo "Cleaning up build artifacts..."
    rm -rf node_modules
    
    # Create necessary directories
    echo "Creating application directories..."
    mkdir -p /opt/app/staticfiles
    mkdir -p /opt/app/backend/db
    mkdir -p /opt/app/logs
    chmod 755 /opt/app/logs
    
    # Pre-collect static files (will use build-time placeholder secret)
    echo "Pre-collecting static files..."
    cd /opt/app/backend
    DJANGO_SECRET_KEY="build-time-secret-key-placeholder" \
        /opt/python/bin/python3 manage.py collectstatic --noinput \
        || { echo "WARNING: collectstatic failed"; }
    
    # Verify Django configuration (with placeholder secret)
    echo "Verifying Django configuration..."
    DJANGO_SECRET_KEY="build-time-secret-key-placeholder" \
        /opt/python/bin/python3 manage.py check --deploy \
        || { echo "WARNING: Django deployment checks failed"; }
    
    # Final cleanup
    echo "Final cleanup..."
    pkill -9 redis-server 2>/dev/null || true
    dnf clean all
    rm -rf /tmp/*
    
    # Create production startup script
cat > /opt/app/start-production.sh << 'STARTSCRIPT'
#!/bin/bash
set -e

echo "========================================="
echo "LLM Web App - Production Startup"
echo "========================================="

# Validate required environment variables
if [ -z "$DJANGO_SECRET_KEY" ]; then
    echo "ERROR: DJANGO_SECRET_KEY environment variable is required!"
    echo "Set it before running: export DJANGO_SECRET_KEY='your-secret-key'"
    exit 1
fi

# Validate secret key is not the placeholder
if [ "$DJANGO_SECRET_KEY" = "build-time-secret-key-placeholder" ]; then
    echo "ERROR: You must set a real DJANGO_SECRET_KEY!"
    exit 1
fi

echo "✓ Environment variables validated"

# Set defaults for optional variables
export ALLOWED_HOSTS=${ALLOWED_HOSTS:-"localhost,127.0.0.1"}
export SERVER_PORT=${SERVER_PORT:-8000}
export WORKERS=${WORKERS:-4}
export REDIS_URL=${REDIS_URL:-"redis://127.0.0.1:6379/1"}

cd /opt/app/backend

# Create logs directory
mkdir -p /var/log/llm-app || mkdir -p /tmp/llm-app-logs
LOG_DIR="/var/log/llm-app"
if [ ! -w "$LOG_DIR" ]; then
    LOG_DIR="/tmp/llm-app-logs"
fi

LOG_ACCESS="${LOG_DIR}/access.log"
LOG_ERROR="${LOG_DIR}/error.log"

echo "Configuration:"
echo "  Port: ${SERVER_PORT}"
echo "  Workers: ${WORKERS}"
echo "  Allowed Hosts: ${ALLOWED_HOSTS}"
echo "  Redis: ${REDIS_URL}"
echo "  Logs: ${LOG_DIR}/"
echo "  Git Commit: $(cat /opt/app/.git-commit 2>/dev/null || echo 'unknown')"
echo "  Build Date: $(cat /opt/app/.build-date 2>/dev/null || echo 'unknown')"
echo "========================================="

# Verify Redis is running
echo "Checking Redis connection..."
if ! redis-cli ping > /dev/null 2>&1; then
    echo "ERROR: Redis is not responding!"
    echo "Redis must be running for the application to work."
    exit 1
fi
echo "✓ Redis is ready"

# Run migrations (safe to run multiple times)
echo "Running database migrations..."
/opt/python/bin/python3 manage.py migrate --noinput \
    || { echo "ERROR: Database migration failed"; exit 1; }
echo "✓ Migrations complete"

# Start Gunicorn with production settings
echo "Starting Gunicorn..."
exec /opt/python/bin/gunicorn \
    --bind ${SERVER_HOST}:${SERVER_PORT} \
    --workers ${WORKERS} \
    --worker-class sync \
    --timeout 120 \
    --max-requests 1000 \
    --max-requests-jitter 50 \
    --access-logfile ${LOG_ACCESS} \
    --error-logfile ${LOG_ERROR} \
    --log-level info \
    --capture-output \
    --enable-stdio-inheritance \
    --chdir /opt/app/backend \
    backend_project.wsgi:application
STARTSCRIPT
    
    chmod +x /opt/app/start-production.sh
    
    echo "========================================="
    echo "Production Build Complete!"
    echo "========================================="

%runscript
    #!/bin/bash
    
    echo "========================================="
    echo "Starting LLM Web App - Production"
    echo "========================================="
    echo "Time: $(date)"
    echo "========================================="
    
    # Create runtime directories
    mkdir -p /var/log/llm-app 2>/dev/null || mkdir -p /tmp/llm-app-logs
    mkdir -p /var/lib/redis 2>/dev/null || mkdir -p /tmp/redis-data
    
    # Determine writable directories
    if [ -w "/var/log/llm-app" ]; then
        REDIS_LOG="/var/log/llm-app/redis.log"
        REDIS_DATA="/var/lib/redis"
    else
        REDIS_LOG="/tmp/llm-app-logs/redis.log"
        REDIS_DATA="/tmp/redis-data"
    fi
    mkdir -p "$REDIS_DATA"
    
    # Clean up any existing Redis
    echo "Checking for existing Redis processes..."
    if pgrep redis-server > /dev/null 2>&1; then
        echo "Cleaning up existing Redis..."
        pkill -9 redis-server
        sleep 2
        fuser -k 6379/tcp 2>/dev/null || true
        sleep 1
    fi
    echo "✓ No existing Redis processes"
    
    # Create production Redis config
    cat > /tmp/redis-production.conf << REDISCONF
# Redis Production Configuration
bind 127.0.0.1
protected-mode yes
port 6379
tcp-backlog 511
timeout 0
tcp-keepalive 300
daemonize no

# Logging
loglevel notice
logfile ${REDIS_LOG}

# Persistence
save 900 1
save 300 10
save 60 10000
stop-writes-on-bgsave-error yes
rdbcompression yes
rdbchecksum yes
dbfilename dump.rdb
dir ${REDIS_DATA}

# Memory management
maxmemory 512mb
maxmemory-policy allkeys-lru

# AOF persistence
appendonly yes
appendfilename "appendonly.aof"
appendfsync everysec
no-appendfsync-on-rewrite no
auto-aof-rewrite-percentage 100
auto-aof-rewrite-min-size 64mb

# Security
# requirepass your-redis-password-here  # Uncomment and set in production if needed
REDISCONF
    
    # Start Redis
    echo "Starting Redis..."
    redis-server /tmp/redis-production.conf > ${REDIS_LOG}.startup 2>&1 &
    REDIS_PID=$!
    
    # Wait for Redis with timeout
    echo "Waiting for Redis to start..."
    for i in {1..30}; do
        if redis-cli ping > /dev/null 2>&1; then
            echo "✓ Redis ready (PID: $REDIS_PID)"
            break
        fi
        
        if [ $i -eq 30 ]; then
            echo "ERROR: Redis failed to start within 30 seconds"
            echo "===== Redis startup log ====="
            cat ${REDIS_LOG}.startup 2>/dev/null || echo "No log available"
            echo "============================="
            exit 1
        fi
        sleep 1
    done
    
    # Verify Redis functionality
    echo "Testing Redis functionality..."
    if ! redis-cli SET production_test "$(date)" > /dev/null 2>&1; then
        echo "ERROR: Redis not responding to commands"
        exit 1
    fi
    TEST_VALUE=$(redis-cli GET production_test 2>&1)
    redis-cli DEL production_test > /dev/null
    echo "✓ Redis test passed"
    
    # Display Redis info
    echo "Redis version: $(redis-cli INFO server | grep redis_version | cut -d: -f2)"
    
    # Start Django application
    echo "========================================="
    echo "Starting Django Application"
    echo "========================================="
    exec /opt/app/start-production.sh

%startscript
    # This runs when using 'apptainer instance start'
    /opt/app/start-production.sh

%test
    echo "Running production container tests..."
    
    # Test Python
    /opt/python/bin/python3 --version || exit 1
    echo "✓ Python installed"
    
    # Test Node
    node --version || exit 1
    echo "✓ Node.js installed"
    
    # Verify repository
    cd /opt/app
    [ -d "backend" ] || { echo "ERROR: backend missing"; exit 1; }
    [ -d "frontend" ] || { echo "ERROR: frontend missing"; exit 1; }
    [ -f "backend/manage.py" ] || { echo "ERROR: manage.py missing"; exit 1; }
    echo "✓ Repository structure valid"
    
    # Verify branch
    BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "detached")
    echo "✓ Git branch/state: $BRANCH"
    
    # Verify build metadata
    [ -f "/opt/app/.git-commit" ] || { echo "ERROR: build metadata missing"; exit 1; }
    echo "✓ Build commit: $(cat /opt/app/.git-commit)"
    echo "✓ Build date: $(cat /opt/app/.build-date)"
    
    # Test Redis installation
    command -v redis-server >/dev/null || { echo "ERROR: redis-server missing"; exit 1; }
    command -v redis-cli >/dev/null || { echo "ERROR: redis-cli missing"; exit 1; }
    echo "✓ Redis installed"
    
    # Verify Redis is not running during tests
    if pgrep redis-server > /dev/null 2>&1; then
        echo "ERROR: Redis should not be running during build"
        exit 1
    fi
    echo "✓ Redis not running (correct for build)"
    
    # Test Django with placeholder secret
    cd /opt/app/backend
    DJANGO_SECRET_KEY="test-secret-key" /opt/python/bin/python3 manage.py check || exit 1
    echo "✓ Django configuration valid"
    
    # Verify frontend build
    [ -f "/opt/app/frontend/dist/index.html" ] || { echo "ERROR: frontend build missing"; exit 1; }
    echo "✓ Frontend build exists"
    
    # Verify static files collected
    [ -d "/opt/app/staticfiles" ] || { echo "ERROR: staticfiles missing"; exit 1; }
    echo "✓ Static files collected"
    
    # Test startup script exists
    [ -f "/opt/app/start-production.sh" ] || { echo "ERROR: startup script missing"; exit 1; }
    [ -x "/opt/app/start-production.sh" ] || { echo "ERROR: startup script not executable"; exit 1; }
    echo "✓ Startup script ready"
    
    echo "========================================="
    echo "All production tests passed!"
    echo "========================================="

%labels
    org.opencontainers.image.title="LLM Web App"
    org.opencontainers.image.description="Production containerized LLM web application"
    org.opencontainers.image.version="1.0"
    org.opencontainers.image.authors="LLM Web App Team"