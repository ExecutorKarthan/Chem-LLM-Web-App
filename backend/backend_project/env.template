# =============================================================================
# backend/backend_project/.env.template — Ubuntu-Server-Deployment branch
#
# On the server this file lives at /var/www/chem-llm/shared/.env
# and is symlinked into each release by deploy.sh automatically.
#
# On first run, deploy.sh generates this with a random secret key.
# You only need to fill it in manually if setting up from scratch.
# =============================================================================

# Generated by deploy.sh on first run — do not change unless rotating keys
DJANGO_SECRET_KEY=your-secret-key-here

# Always False on the server
DJANGO_DEBUG=False

# !! REPLACE YOUR_SUBDOMAIN once confirmed with WashU IT !!
# Format: subdomain.chemistry.wustl.edu
PRODUCTION_DOMAIN=YOUR_SUBDOMAIN.chemistry.wustl.edu
